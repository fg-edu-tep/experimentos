# Environment Configuration Template for Bite Latency Experiment
# Copy this file to .env and adjust the values for your deployment

# ============================================
# Django Configuration
# ============================================
SECRET_KEY=your-secret-key-change-this-in-production-use-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com,your-vps-ip

# ============================================
# PostgreSQL Database Configuration
# ============================================
DB_NAME=bite_latency
DB_USER=bite_user
DB_PASSWORD=secure_password_change_this
DB_HOST=postgres
DB_PORT=5432

# ============================================
# Redis Cache Configuration
# ============================================
REDIS_URL=redis://redis:6379

# ============================================
# Kong API Gateway Configuration
# ============================================
KONG_PG_PASSWORD=kong_secure_password_change_this

# ============================================
# Django Superuser (Optional)
# ============================================
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin_password_change_this

# ============================================
# Data Seeding and Cache Warming (Optional)
# ============================================
# Set to true to seed data on deployment
SEED_DATA=false
SEED_PROJECTS=10
SEED_MONTHS=3

# Set to true to warm cache on deployment
WARM_CACHE=false
WARM_CACHE_LIMIT=100

# ============================================
# Production Notes for AWS VPS Ubuntu 24
# ============================================
# 1. Generate a secure SECRET_KEY:
#    python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
#
# 2. Set DEBUG=False for production
#
# 3. Update ALLOWED_HOSTS with your actual domain/IP
#
# 4. Use strong passwords for all database credentials
#
# 5. Kong API Keys are defined in kong/kong.yml
#    Update the production key before deployment
#
# 6. For SSL/HTTPS, you'll need to configure Kong with certificates
#    or use a reverse proxy like Nginx
#
# 7. Make sure this .env file has restricted permissions:
#    chmod 600 .env
